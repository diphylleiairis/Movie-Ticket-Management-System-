SUPABASE_ANON_KEY=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_URL=""
# Backend-only public poster bucket. Provision with the documented setup script.
POSTER_STORAGE_BUCKET="movie-posters"
POSTGRES_URL=""
POSTGRES_PASSWORD=""
POSTGRES_HOST=""
POSTGRES_PORT=""
POSTGRES=""
POSTGRES_USER=""
# Per backend instance; local, Render and overlapping deploys share DB capacity.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE="3"
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE="0"
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT="60000"
IDENTITY_API_URL=""
GOOGLE_AUTH_URL=""
APPLE_AUTH_URL=""
# Backend-only Google OAuth credentials. Never expose the secret through VITE_*.
# After supplying Google credentials, enable local Google login with dev,google.
SPRING_PROFILES_ACTIVE="dev"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/login/oauth2/code/google"
FRONTEND_URL="http://localhost:5173"
# Backend email delivery. Resend is the default; keep its key out of VITE_*.
IDENTITY_MAIL_PROVIDER="resend"
RESEND_API_KEY=""
# Required: sender on your verified Resend domain.
# onboarding@resend.dev is restricted to sending to the Resend account owner.
IDENTITY_MAIL_FROM=""
# Backend-only JSON map: key version -> Base64-encoded 32-byte AES key.
# Keep historical versions to recover existing ticket QR tokens. Never use VITE_*.
TICKET_QR_KEYS='{}'
# Optional SMTP alternative: set IDENTITY_MAIL_PROVIDER=smtp.
SPRING_MAIL_HOST=""
SPRING_MAIL_PORT="587"
SPRING_MAIL_USERNAME=""
SPRING_MAIL_PASSWORD=""
